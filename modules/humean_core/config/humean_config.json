{
  "version": "1.0",
  "system": {
    "name": "HUMEAN Cognitive System",
    "mode": "production",
    "auto_update": true
  },
  "cognitive_engine": {
    "primary": "gemini",
    "fallbacks": ["ollama", "huggingface"],
    "energy_threshold": 0.5,
    "max_context_memories": 5
  },
  "apis": {
    "ollama": {
      "enabled": true,
      "base_url": "http://localhost:11434",
      "default_model": "llama3.2:3b"
    },
    "gemini": {
      "enabled": true,
      "api_key": "YOUR_GEMINI_API_KEY_HERE",
      "model": "gemini-2.0-flash"
    },
    "huggingface": {
      "enabled": false,
      "api_key": "YOUR_HF_API_KEY_HERE",
      "model": "microsoft/DialoGPT-medium"
    }
  },
  "modules": {
    "gateway": "operational",
    "memory": "operational",
    "scheduler": "ready",
    "ethics": "ready",
    "monitoring": "operational"
  },
  "energy_settings": {
    "daily_cognitive_budget": 10.0,
    "energy_optimization": true,
    "memory_compression_threshold": 0.1
  }
}
